# Deriv "new API" configuration (all optional for market data).
# Register an app at https://developers.deriv.com to get these values.

# OAuth client id — enables the "Log in" / "Sign in with Deriv" buttons (redirect URI: <origin>/app)
VITE_DERIV_CLIENT_ID=

# Sent as the Deriv-App-ID header on accounts / OTP REST calls
VITE_DERIV_APP_ID=

# Overrides (defaults shown)
# VITE_DERIV_API_BASE=https://api.derivws.com/trading/v1/
# VITE_DERIV_AUTH_BASE=https://auth.deriv.com/oauth2/
